{
  "id": "./",
  "name": "Budget Tracker",
  "short_name": "Budget",
  "description": "Track your daily income and expenses in rupees. Works offline; your data stays on your device.",
  "lang": "en-IN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#3546AB",
  "theme_color": "#3546AB",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add expense",
      "description": "Record money you spent",
      "url": "./#/?add=expense",
      "icons": [
        {
          "src": "icons/shortcut-expense-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcut-expense-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Add income",
      "description": "Record money you received",
      "url": "./#/?add=income",
      "icons": [
        {
          "src": "icons/shortcut-income-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcut-income-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Monthly overview",
      "short_name": "Monthly",
      "description": "Income vs expenses for the year",
      "url": "./#/monthly",
      "icons": [
        {
          "src": "icons/shortcut-monthly-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "icons/shortcut-monthly-192.png",
